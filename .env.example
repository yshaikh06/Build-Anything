# Example environment variables for running n8n
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_SECURE_COOKIE=false

# Placeholder credentials (actual secrets are stored securely inside n8n)
GEMINI_API_KEY=your_gemini_key_here
RENTCAST_API_KEY=your_rentcast_key_here
GMAIL_CLIENT_ID=your_gmail_client_id_here
GMAIL_CLIENT_SECRET=your_gmail_client_secret_here

# Optional: Function App URL (frontend uses this in script.js)
FUNCTION_APP_URL=https://your-function-app-url-here.azurewebsites.net/api/submitform
